{:paths ["src"]
 :deps  {org.javamoney/moneta {:mvn/version "1.4.5"
                               :extension   "pom"}}
 :aliases
 {:dev     {:extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}}}
  :test    {:extra-deps  {io.github.matthewdowney/rich-comment-tests
                          {:mvn/version "v1.0.3"}}
            :extra-paths ["test"]
            :exec-fn     test/run-tests!
            :exec-args   {:dirs #{"src"}}}
  :infra   {:extra-paths ["infra"]
            :deps        {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
            :ns-default  build}
  :release {:extra-paths ["infra"]
            :extra-deps  {io.github.clojure/tools.build {:mvn/version "0.10.14"}}}
  :deploy  {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
            :exec-fn    deps-deploy.deps-deploy/deploy
            :exec-args  {:installer     :remote
                         :sign-release? true
                         :artifact      "target/shrapnel.jar"}}}}
